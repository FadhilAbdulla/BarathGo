{
  "name": "barathgo-web",
  "version": "1.0.0",
  "private": true,
  "description": "Website for BarathGo, the cooperative taxi platform launched under NFTCI",
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "next build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "db:migrate:local": "wrangler d1 migrations apply barathgo --local",
    "db:migrate": "wrangler d1 migrations apply barathgo --remote",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
