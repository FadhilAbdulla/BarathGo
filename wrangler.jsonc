{
  // Cloudflare Worker: canonical-host redirects, the BarathGo API (/api/*) on D1, and the static Next.js export in out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barathgo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // `wrangler deploy` / `wrangler dev` run the Next.js static export first.
  "build": { "command": "npm run build", "watch_dir": ["app", "components", "lib", "public"] },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barathgo",
      // Replace with the id printed by `npx wrangler d1 create barathgo` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Forms and fare quotes: 30 per minute per IP
    { "name": "REQUEST_LIMITER", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    // Login codes: 10 per minute per IP (mobile carriers share IPs); each phone is also limited to one code per 30 s
    { "name": "OTP_LIMITER", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "MAIL_FROM": "BarathGo Website <website@barathgo.com>"
  }
  // Secrets (`npx wrangler secret put NAME`, never in git):
  //   ADMIN_PHONES        — comma-separated mobiles with admin access
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM — SMS for login codes
  //   RESEND_API_KEY, MAIL_TO — email delivery for website enquiries
  //   OSRM_URL (optional)  — your own routing server; the default public demo server is for testing only
  // Local development: copy .dev.vars.example to .dev.vars (DEV_MODE=1 shows login codes on screen).
}
